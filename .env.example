# Sao chép file này thành .env trước khi chạy Docker Compose.
# Thay toàn bộ mật khẩu/khóa mẫu bằng giá trị ngẫu nhiên riêng trước khi triển khai.

# === Cơ sở dữ liệu PostgreSQL ===
POSTGRES_DB=security_monitor
POSTGRES_USER=security
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# === Bảo mật Backend & Tài khoản Quản trị mặc định ===
SECRET_KEY=replace-with-at-least-32-random-bytes
AI_SERVICE_TOKEN=replace-with-a-separate-random-service-token
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-long-password
REGISTRATION_ENABLED=false
SEED_DEMO_DATA=false

# === Edge AI YOLOv8 PCCC (Nhận diện Lửa & Khói) ===
MODEL_PATH=/models/yolov8n_fire_smoke.onnx
YOLO_CLASSES=fire,smoke
CONFIDENCE_THRESHOLD=0.6
NMS_IOU_THRESHOLD=0.45
FFMPEG_TIMEOUT_SECS=10

# === Hạ tầng Mạng Mở rộng (Docker Profiles: rtsp / vpn / monitoring / full) ===
RTSP_SERVER_URL=rtsp://mediamtx:8554
WIREGUARD_ACTIVE=false
WIREGUARD_SERVERURL=auto
WIREGUARD_PORT=51820
WIREGUARD_PEERS=admin,operator1
WIREGUARD_SUBNET=10.13.13.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-password
