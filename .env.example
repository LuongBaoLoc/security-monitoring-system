# Copy to .env for Docker Compose. Replace all development values before deployment.
POSTGRES_DB=security_monitor
POSTGRES_USER=security
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SECRET_KEY=replace-with-at-least-32-random-bytes
AI_SERVICE_TOKEN=replace-with-a-separate-random-service-token
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-long-password
REGISTRATION_ENABLED=false
SEED_DEMO_DATA=false
MQTT_COMMAND_TIMEOUT_SECONDS=15
CONFIDENCE_THRESHOLD=0.5
AI_CAMERA_ID=
AI_RTSP_URL=
AI_FRAME_INTERVAL_SECONDS=5
